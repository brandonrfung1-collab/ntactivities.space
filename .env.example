# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. Both of these are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project Settings → API → service_role. SERVER ONLY — never prefix with
# NEXT_PUBLIC_. Used by `npm run seed` and by admin service-role operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical origin, used for metadata, OpenGraph URLs, sitemap and .ics links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leaving the Supabase vars unset is supported: the app runs in demo mode and
# reads the local seed dataset in src/lib/data instead.
